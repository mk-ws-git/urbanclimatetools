---
import type { CollectionEntry } from 'astro:content';

interface Props {
  tool: CollectionEntry<'tools'>;
  compact?: boolean;
}

const { tool, compact = false } = Astro.props;
const { title, tagline, category, tags, license, difficulty, featured, citedBy } = tool.data;

const difficultyLabel = { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' };
const difficultyColor = {
  beginner:     'bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300',
  intermediate: 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300',
  advanced:     'bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300',
};
---

<a
  href={`/tools/${tool.id}`}
  class:list={[
    'card-hover group flex flex-col',
    compact ? 'p-4' : 'p-6',
  ]}
>
  {featured && (
    <div class="mb-3 flex items-center gap-1.5 text-xs font-medium text-amber-600 dark:text-amber-400">
      <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 1l1.94 4.02L14 5.68l-3 2.92.71 4.12L8 10.6l-3.71 2.12.71-4.12L2 5.68l4.06-.66L8 1z"/>
      </svg>
      Featured
    </div>
  )}

  <div class="flex items-start justify-between gap-3">
    <h3 class:list={['font-semibold text-stone-900 group-hover:text-forest-700 dark:text-stone-100 dark:group-hover:text-forest-400 transition-colors', compact ? 'text-sm' : 'text-base']}>
      {title}
    </h3>
    <span class="badge category-chip shrink-0" data-cat={category}>
      {category}
    </span>
  </div>

  {!compact && (
    <p class="mt-2 text-sm text-stone-500 dark:text-stone-400 line-clamp-2">{tagline}</p>
  )}

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <span class:list={['badge', difficultyColor[difficulty]]}>{difficultyLabel[difficulty]}</span>
    <span class="badge bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400">{license}</span>
    {citedBy > 0 && (
      <span class="ml-auto flex items-center gap-1 text-xs text-stone-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 8V5a1 1 0 011-1h2m0 0V2m0 2h4m0 0V2m0 2h2a1 1 0 011 1v3" stroke-linecap="round"/>
          <rect x="2" y="8" width="12" height="6" rx="1"/>
        </svg>
        {citedBy} citations
      </span>
    )}
  </div>

  {!compact && tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 4).map((tag) => (
        <span class="rounded-md bg-stone-50 px-2 py-0.5 text-xs text-stone-500 dark:bg-stone-800 dark:text-stone-500">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
