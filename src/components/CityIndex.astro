---
// "The city as index": an axonometric city block whose parts open the tools and
// case studies that apply to them. The drawing is generated by
// scripts/gen-city-block.py; hotspot positions below come from its output.
// Tool names, links and case-study figures are read from the content
// collections, so nothing here can drift from the catalogue.
import { getEntry } from 'astro:content';
import cityBlock from '../assets/city-block.svg?raw';
import { categoryLabel } from '../lib/labels.mjs';

const spots = [
  {
    id: 'green-roof', left: 42.99, top: 13.5, hazard: 'Heat and stormwater', title: 'Green roof',
    body: 'Planted roofs hold rain where it lands and keep the building, and the air above it, cooler.',
    tools: ['roof-savings-calculator', 'i-tree'], study: 'tokyo-japan',
  },
  {
    id: 'water-square', left: 28.57, top: 50.56, hazard: 'Flooding', title: 'Water square',
    body: 'A public square that is a sports court in dry weather and a storage basin in a cloudburst.',
    tools: ['stormwater-calculator', 'epa-swmm'], study: 'rotterdam-netherlands',
  },
  {
    id: 'street-trees', left: 55.26, top: 49.3, hazard: 'Heat', title: 'Street trees',
    body: 'Canopy shades the street, cools the air and slows runoff. Where it goes matters as much as how much.',
    tools: ['i-tree', 'tree-equity-score'], study: 'vienna-austria',
  },
  {
    id: 'cool-schoolyard', left: 55.84, top: 70.06, hazard: 'Heat', title: 'Cool schoolyard',
    body: 'Asphalt yards rebuilt with shade, planting and pale, permeable surfaces, open to the neighbourhood in heatwaves.',
    tools: ['eea-urban-heat-island', 'envi-met'], study: 'paris-france',
  },
  {
    id: 'living-shoreline', left: 34.42, top: 70.9, hazard: 'Coasts and sea level', title: 'Living shoreline',
    body: 'Marsh, reef and planted edges that absorb wave energy and give rising water somewhere to go.',
    tools: ['coastal-resilience', 'noaa-slr'], study: 'miami-usa',
  },
];

const DEFAULT = 1; // water square

const panels = await Promise.all(
  spots.map(async (s, i) => {
    const tools = await Promise.all(
      s.tools.map(async (slug) => {
        const t = await getEntry('tools', slug);
        if (!t) throw new Error(`CityIndex: unknown tool "${slug}"`);
        return { href: `/tools/${t.id}`, title: t.data.title, kind: categoryLabel(t.data.category) };
      }),
    );
    const study = await getEntry('case-studies', s.study);
    if (!study) throw new Error(`CityIndex: unknown case study "${s.study}"`);
    if (!study.data.statValue || !study.data.statLabel) {
      throw new Error(`CityIndex: case study "${s.study}" needs statValue and statLabel`);
    }
    return {
      ...s,
      num: String(i + 1).padStart(2, '0'),
      tools,
      study: {
        href: `/case-studies/${study.id}`,
        city: study.data.city,
        stat: study.data.statValue,
        label: study.data.statLabel,
      },
    };
  }),
);
---

<section class="city-index" aria-label="The city as index" data-city-index>
  <figure class="drawing">
    <div class="stage">
      <Fragment set:html={cityBlock} />
      {panels.map((p, i) => (
        <button
          type="button"
          class="spot"
          style={`left: calc(${p.left}% - 22px); top: calc(${p.top}% - 22px)`}
          aria-pressed={i === DEFAULT ? 'true' : 'false'}
          aria-controls={`spot-${p.id}`}
          aria-label={p.title}
          data-spot={i}
        >
          {p.num}
        </button>
      ))}
    </div>
    <figcaption>Fig. 1 · A composite city block, not to scale</figcaption>
    <div class="chips" role="group" aria-label="Parts of the city">
      {panels.map((p, i) => (
        <button type="button" class="chip" aria-pressed={i === DEFAULT ? 'true' : 'false'} aria-controls={`spot-${p.id}`} data-spot={i}>
          <span class="chip-num">{p.num}</span> {p.title}
        </button>
      ))}
    </div>
  </figure>

  <div class="panels" aria-live="polite">
    {panels.map((p, i) => (
      <article id={`spot-${p.id}`} class="panel" data-panel={i} hidden={i !== DEFAULT}>
        <p class="section-label">{p.num} · {p.hazard}</p>
        <h2>{p.title}</h2>
        <p class="body">{p.body}</p>

        <div class="tools">
          <p class="label">Tools for this</p>
          {p.tools.map((t) => (
            <a href={t.href} class="tool">
              <span>{t.title}</span>
              <span class="kind">{t.kind}</span>
            </a>
          ))}
        </div>

        <div class="seen">
          <p class="label">Seen in {p.study.city}</p>
          <p class="stat">{p.study.stat}</p>
          <p class="stat-label">{p.study.label}</p>
          <a href={p.study.href} class="more">Read the case study</a>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-city-index]').forEach((root) => {
    const spots = root.querySelectorAll<HTMLButtonElement>('[data-spot]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    spots.forEach((spot) => {
      spot.addEventListener('click', () => {
        const n = spot.dataset.spot;
        spots.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.spot === n)));
        panels.forEach((p) => { p.hidden = p.dataset.panel !== n; });
      });
    });
  });
</script>

<style>
  .city-index {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: stretch;
  }
  .drawing {
    flex: 999 1 620px;
    min-width: 0;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
  }
  .stage { position: relative; }
  figcaption {
    margin: 0.75rem 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .spot {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    background: var(--surface);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .spot:hover,
  .spot[aria-pressed='true'] {
    border-color: var(--accent-solid);
    background: var(--accent-solid);
    color: var(--on-accent);
  }
  .spot[aria-pressed='true'] { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-solid) 30%, transparent); }

  /* Small screens: the markers shrink to fit the drawing, and a row of
     full-size buttons below it carries the touch targets. */
  .chips { display: none; }
  @media (max-width: 640px) {
    .drawing { padding: 0.5rem; }
    .spot { width: 32px; height: 32px; margin: 6px; font-size: 0.75rem; }
    .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0.25rem 0.25rem; }
    .chip {
      min-height: 44px;
      padding: 0 0.875rem;
      border: 1px solid var(--ink-3);
      border-radius: 4px;
      background: transparent;
      color: var(--ink);
      font-size: 0.875rem;
      cursor: pointer;
    }
    .chip-num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
    .chip[aria-pressed='true'] { border-color: var(--accent-solid); background: var(--accent-solid); color: var(--on-accent); }
    .chip[aria-pressed='true'] .chip-num { color: var(--on-accent); }
  }

  .panels {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    border-top: 1px solid var(--accent);
    padding-top: 1.25rem;
  }
  .panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .panel[hidden] { display: none; }
  .panel h2 { font-size: 2.25rem; line-height: 1.05; }
  .body { color: var(--ink-2); }
  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .tool {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .tool:hover { border-bottom-color: var(--accent); }
  .kind {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
    text-align: right;
  }
  .seen {
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .stat {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--green);
  }
  .stat-label { margin-top: 0.25rem; color: var(--ink-2); }
  .more {
    display: inline-block;
    padding: 0.75rem 0;
    font-size: 0.9375rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
