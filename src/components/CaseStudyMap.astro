---
import type { CollectionEntry } from 'astro:content';

interface Props {
  studies: CollectionEntry<'case-studies'>[];
}
const { studies } = Astro.props;

const markers = studies.map((s) => ({
  lat: s.data.lat,
  lng: s.data.lng,
  city: s.data.city,
  country: s.data.country,
  slug: s.id,
  themes: s.data.themes,
  stat: s.data.statValue ?? '',
  label: s.data.statLabel ?? '',
}));
---

<div class="relative overflow-hidden rounded-[4px] border" style="border-color: var(--rule)">
  <div id="case-study-map" class="uct-map h-[300px] sm:h-[480px] w-full" style="background: var(--surface)"></div>
</div>

<!-- Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script define:vars={{ markers }}>
  window.addEventListener('load', () => {
    const L = window.L;
    if (!L) return;

    const tiles = (dark) => L.tileLayer(
      dark
        ? 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}'
        : 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}',
      { attribution: 'Tiles &copy; Esri &mdash; Esri, HERE, Garmin, OpenStreetMap contributors', maxZoom: 16 },
    );

    const map = L.map('case-study-map', { zoomControl: true, scrollWheelZoom: false })
      .setView([15, 15], 2);

    // Follow the site theme (the toggle), and swap tiles when it changes.
    let layer = tiles(document.documentElement.classList.contains('dark')).addTo(map);
    document.addEventListener('themechange', (e) => {
      map.removeLayer(layer);
      layer = tiles(e.detail.dark).addTo(map);
      layer.bringToBack();
    });

    // One marker style in the site accent; the figure does the talking in the popup.
    markers.forEach((m) => {
      const figure = m.stat
        ? `<p style="font-size:22px; font-weight:600; letter-spacing:-0.03em; margin:6px 0 0; color:#1B6A48">${m.stat}</p>
           <p style="font-size:12px; margin:2px 0 8px; color:#3A4841">${m.label}</p>`
        : '';
      const popup = `
        <div style="min-width:190px; font-family: 'Inter Variable', Inter, system-ui, sans-serif;">
          <strong style="font-size:13px">${m.city}, ${m.country}</strong>
          ${figure}
          <a href="/case-studies/${m.slug}" style="font-size:12px; color:#9A4A0C; font-weight:600; text-decoration:underline">Read the case study</a>
        </div>`;
      L.circleMarker([m.lat, m.lng], { radius: 7, color: '#0F1714', weight: 1.5, fillColor: '#F2A65A', fillOpacity: 1 })
        .addTo(map)
        .bindPopup(popup);
    });
  });
</script>
