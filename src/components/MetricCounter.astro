---
interface Props {
  value: string | number;
  label: string;
  sublabel?: string;
}
const { value, label, sublabel } = Astro.props;
---

<div class="flex flex-col items-center gap-1 text-center">
  <span
    class="text-4xl font-bold text-forest-600 dark:text-forest-400 tabular-nums"
    data-counter={value}
  >
    {value}
  </span>
  <span class="text-sm font-medium text-stone-700 dark:text-stone-300">{label}</span>
  {sublabel && <span class="text-xs text-stone-400">{sublabel}</span>}
</div>
