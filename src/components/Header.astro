---
const navLinks = [
  { href: '/tools',         label: 'Tools' },
  { href: '/case-studies',  label: 'Case Studies' },
  { href: '/data',          label: 'Data' },
  { href: '/about',         label: 'About' },
  { href: '/search',        label: 'Search' },
];

const pathname = Astro.url.pathname;
---

<header class="uct-header fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Logo + wordmark -->
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Urban Climate Tools home">
      <img src="/logo-light.png" alt="" class="h-7 w-auto dark:hidden" aria-hidden="true" />
      <img src="/logo-dark.png"  alt="" class="h-7 w-auto hidden dark:block" aria-hidden="true" />
      <span class="text-sm font-semibold text-stone-900 dark:text-stone-100 hidden sm:inline">
        Urban Climate Tools
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
            pathname.startsWith(href)
              ? 'bg-stone-900/8 text-stone-900 dark:bg-white/10 dark:text-white'
              : 'text-stone-500 hover:bg-stone-900/6 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-white/8 dark:hover:text-white',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-1 shrink-0">
      <button
        id="theme-toggle"
        class="rounded-lg p-2 text-stone-500 hover:bg-stone-900/6 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-white/8 dark:hover:text-white transition-colors"
        aria-label="Toggle dark mode"
      >
        <svg class="h-4.5 w-4.5 hidden dark:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="10" cy="10" r="4"/>
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.22 4.22l1.42 1.42M14.36 14.36l1.42 1.42M4.22 15.78l1.42-1.42M14.36 5.64l1.42-1.42" stroke-linecap="round"/>
        </svg>
        <svg class="h-4.5 w-4.5 dark:hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
      </button>

      <a
        href="https://github.com/mk-ws-git/urbanclimatetools"
        target="_blank"
        rel="noreferrer"
        class="rounded-lg p-2 text-stone-500 hover:bg-stone-900/6 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-white/8 dark:hover:text-white transition-colors"
        aria-label="GitHub repository"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>

      <button id="mobile-menu-btn" class="rounded-lg p-2 text-stone-500 hover:bg-stone-900/6 dark:text-stone-400 dark:hover:bg-white/8 transition-colors md:hidden" aria-label="Open menu">
        <svg class="h-4.5 w-4.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="hidden border-t border-stone-900/8 dark:border-white/8 md:hidden">
    <nav class="flex flex-col gap-0.5 px-4 py-2 pb-3">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="rounded-md px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-900/6 hover:text-stone-900 dark:text-stone-300 dark:hover:bg-white/8 dark:hover:text-white transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>


<script>
  const toggle = document.getElementById('theme-toggle');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  mobileBtn?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
