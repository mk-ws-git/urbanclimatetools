---
const year = new Date().getFullYear();

const links = {
  Explore: [
    { href: '/tools',        label: 'All tools' },
    { href: '/case-studies', label: 'Case studies' },
    { href: '/data',         label: 'Data explorer' },
    { href: '/about',        label: 'About' },
  ],
  Project: [
    { href: 'https://github.com/mk-ws-git/urbanclimatetools/blob/main/CONTRIBUTING.md', label: 'Suggest a tool' },
    { href: 'https://github.com/mk-ws-git/urbanclimatetools',                         label: 'GitHub' },
    { href: 'https://github.com/mk-ws-git/urbanclimatetools/blob/main/LICENSE',       label: 'MIT licence' },
  ],
};
---

<footer class="site-footer">
  <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-x-16 gap-y-10 px-4 py-12 sm:px-6 lg:px-8">

    <div class="max-w-md">
      <p class="credit">
        Compiled and maintained by Mary Sprague, urban designer and software developer in Berlin.
        Every figure links to its source.
      </p>
      <p class="small">&copy; {year} Urban Climate Tools. Code under the MIT licence.</p>
    </div>

    <div class="flex flex-wrap gap-x-16 gap-y-8">
      {Object.entries(links).map(([group, items]) => (
        <nav aria-label={group}>
          <h3 class="section-label">{group}</h3>
          <ul class="mt-2">
            {items.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="footer-link"
                  {...(href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }
  .credit { color: var(--ink-2); }
  .small {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .footer-link {
    display: inline-block;
    padding-block: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }
  .footer-link:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }
</style>
