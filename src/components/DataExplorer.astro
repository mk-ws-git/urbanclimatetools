---
import metrics from '../data/metrics.json';
import { getCatalogStats } from '../lib/catalog';
import { categoryLabel } from '../lib/labels.mjs';

const { categoryCounts } = await getCatalogStats();
const maxCount = Math.max(1, ...Object.values(categoryCounts));
---

<section id="data-explorer">
  <div class="group-head first">
    <h2>Why this matters</h2>
    <span class="meta">Global context</span>
  </div>
  <div class="entry-grid context">
    {metrics.climateMetrics.map((m) => (
      <div class="entry">
        <span class="figure-stat">{m.value}</span>
        <span class="entry-label">{m.label}</span>
        <span class="meta">Source: {m.source}</span>
      </div>
    ))}
  </div>

  <div class="group-head">
    <h2>The catalogue by challenge</h2>
    <span class="meta">Tools per category</span>
  </div>
  {metrics.categories.map((cat) => (
    <a href={`/tools?cat=${cat.id}`} class="bar-row">
      <span class="bar-name">{categoryLabel(cat.id)}</span>
      <span class="bar-track" aria-hidden="true">
        <span class="bar-fill" style={`width: ${((categoryCounts[cat.id] ?? 0) / maxCount) * 100}%`}></span>
      </span>
      <span class="meta">{categoryCounts[cat.id] ?? 0} tools</span>
    </a>
  ))}
</section>

<style>
  .first { margin-top: 0; }
  .context { margin-top: 1rem; }
  .context .entry { border-top: 0; padding-top: 0.5rem; }
  .bar-row {
    display: grid;
    grid-template-columns: minmax(9rem, 16rem) minmax(0, 1fr) 5rem;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .bar-row:hover { border-bottom-color: var(--accent); }
  .bar-name { font-size: 1.125rem; }
  .bar-track { display: block; height: 0.625rem; }
  .bar-fill { display: block; height: 100%; background: var(--accent-solid); border: 1px solid var(--ink); }
  .bar-row .meta { text-align: right; }
  @media (max-width: 640px) {
    .bar-row { grid-template-columns: minmax(0, 1fr) 5rem; }
    .bar-track { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
