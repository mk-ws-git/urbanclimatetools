---
// Two questions, both of which actually drive the result: the challenge picks
// the category, the background sets the difficulty ceiling. Everything is read
// from the tools collection, so the finder can never recommend a missing tool.
import { getCollection } from 'astro:content';
import { categoryLabel, difficultyLabel } from '../lib/labels.mjs';

const toolData = (await getCollection('tools'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title))
  .map((t) => ({
    slug: t.id,
    title: t.data.title,
    tagline: t.data.tagline,
    cat: t.data.category,
    difficulty: t.data.difficulty,
    level: difficultyLabel(t.data.difficulty),
  }));

const challenges = [
  ['heat',     'Urban heat and thermal comfort'],
  ['flood',    'Flooding and stormwater'],
  ['coastal',  'Sea level rise and coastal erosion'],
  ['green',    'Green infrastructure and nature-based solutions'],
  ['data',     'Climate data and risk analysis'],
  ['planning', 'Policy, planning and investment'],
];
const backgrounds = [
  ['beginner',     'Non-technical', 'Policy, communications or community role'],
  ['intermediate', 'Technical',     'GIS or analyst background'],
  ['advanced',     'Specialist',    'Modelling or engineering experience'],
];
const catLabels = Object.fromEntries(challenges.map(([id]) => [id, categoryLabel(id)]));
---

<div class="finder" data-finder data-tools={JSON.stringify(toolData)} data-labels={JSON.stringify(catLabels)}>

  <div data-step="1">
    <p class="meta">Question 1 of 2</p>
    <h3>What is your main climate challenge?</h3>
    <div class="options">
      {challenges.map(([val, label]) => (
        <button type="button" class="option" data-q="cat" data-val={val}>{label}</button>
      ))}
    </div>
  </div>

  <div data-step="2" hidden>
    <p class="meta">Question 2 of 2</p>
    <h3>What is your technical background?</h3>
    <div class="options">
      {backgrounds.map(([val, label, sub]) => (
        <button type="button" class="option" data-q="level" data-val={val}>
          <span class="option-title">{label}</span>
          <span class="option-sub">{sub}</span>
        </button>
      ))}
    </div>
    <button type="button" class="back" data-back>Back</button>
  </div>

  <div data-step="results" hidden aria-live="polite">
    <p class="meta" data-summary></p>
    <h3 data-heading></h3>
    <div data-list></div>
    <div class="after">
      <a class="text-link" data-all href="/tools">See everything for this challenge</a>
      <button type="button" class="back" data-restart>Start over</button>
    </div>
  </div>
</div>

<script>
  type Tool = { slug: string; title: string; tagline: string; cat: string; difficulty: string; level: string };
  const rank: Record<string, number> = { beginner: 0, intermediate: 1, advanced: 2 };

  document.querySelectorAll<HTMLElement>('[data-finder]').forEach((root) => {
    const tools: Tool[] = JSON.parse(root.dataset.tools ?? '[]');
    const labels: Record<string, string> = JSON.parse(root.dataset.labels ?? '{}');
    const answers: Record<string, string> = {};
    const steps = root.querySelectorAll<HTMLElement>('[data-step]');
    const show = (name: string) => steps.forEach((s) => { s.hidden = s.dataset.step !== name; });
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    function results() {
      const max = rank[answers.level] ?? 2;
      const matches = tools.filter((t) => t.cat === answers.cat && rank[t.difficulty] <= max);
      const label = labels[answers.cat] ?? answers.cat;
      root.querySelector('[data-summary]')!.textContent = `${label} · up to ${answers.level} level`;
      root.querySelector('[data-heading]')!.textContent = matches.length
        ? `${matches.length} tool${matches.length !== 1 ? 's' : ''} fit that.`
        : 'Nothing fits both answers yet.';
      root.querySelector('[data-list]')!.innerHTML = matches
        .map((t) => `
          <a href="/tools/${t.slug}" class="row two">
            <span><span class="row-title">${esc(t.title)}</span><span class="row-sub block">${esc(t.tagline)}</span></span>
            <span class="meta">${esc(t.level)}</span>
          </a>`)
        .join('');
      root.querySelector<HTMLAnchorElement>('[data-all]')!.href = `/tools?cat=${answers.cat}`;
      show('results');
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const option = target.closest<HTMLButtonElement>('.option');
      if (option) {
        answers[option.dataset.q!] = option.dataset.val!;
        if (option.dataset.q === 'cat') show('2'); else results();
        return;
      }
      if (target.closest('[data-back]') || target.closest('[data-restart]')) show('1');
    });
  });
</script>

<style>
  .finder {
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
  }
  .finder h3 {
    margin-top: 0.5rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0;
    margin-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .option {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-height: 3.5rem;
    justify-content: center;
    padding: 0.75rem 1rem 0.75rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, padding 0.15s;
  }
  .option:hover { color: var(--accent); border-bottom-color: var(--accent); padding-left: 0.5rem; }
  .option-title { font-weight: 500; }
  .option-sub { font-size: 0.875rem; color: var(--ink-2); }
  .back {
    margin-top: 0.75rem;
    padding: 0.75rem 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .back:hover { color: var(--ink); }
  .after { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 2rem; margin-top: 0.5rem; }
  .after .back { margin-top: 0; }
  [data-list] { margin-top: 0.75rem; border-top: 1px solid var(--rule); }
  @media (prefers-reduced-motion: reduce) { .option { transition: none; } }
</style>
