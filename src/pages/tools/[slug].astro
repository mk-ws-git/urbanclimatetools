---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabel, licenseSummary, difficultyLabel } from '../../lib/labels.mjs';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);
const {
  title, tagline, category, tags, license, language, homepage, github,
  difficulty, lastUpdated, dataInputs, outputs, ogImage,
} = tool.data;

// Related tools: same category, not this one
const allTools = await getCollection('tools');
const related = allTools.filter((t) => t.data.category === category && t.id !== tool.id).slice(0, 6);

// Case studies that list this tool
const usedIn = (await getCollection('case-studies')).filter((s) => s.data.toolsUsed.includes(tool.id));

const resolvedOg = ogImage ?? `/og/tools-${tool.id}.png`;
---

<BaseLayout title={title} description={tagline} type="article" ogImage={resolvedOg}>
  <div class="page">

    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/tools">Tools</a><span>/</span><span>{title}</span>
    </nav>

    <header class="page-head head">
      <p class="section-label">Tool · {categoryLabel(category)}</p>
      <h1 class="wide">{title}</h1>
      <p class="lede">{tagline}</p>
      <div class="actions">
        {homepage && <a href={homepage} target="_blank" rel="noreferrer" class="btn-primary">Open the tool</a>}
        {github && <a href={github} target="_blank" rel="noreferrer" class="btn-secondary">Source on GitHub</a>}
      </div>
    </header>

    <dl class="sheet">
      <div><dt class="meta">Addresses</dt><dd><a href={`/tools?cat=${category}`} class="sheet-link">{categoryLabel(category)}</a></dd></div>
      <div><dt class="meta">Cost</dt><dd>{licenseSummary(license)}</dd></div>
      <div><dt class="meta">Licence</dt><dd>{license}</dd></div>
      <div><dt class="meta">Level</dt><dd>{difficultyLabel(difficulty)}</dd></div>
      {language && <div><dt class="meta">Built with</dt><dd>{language}</dd></div>}
      <div><dt class="meta">Entry updated</dt><dd>{String(lastUpdated)}</dd></div>
    </dl>

    <section class="io" aria-label="Inputs and outputs">
      <div>
        <h2 class="text-sm meta">You bring</h2>
        <ul>
          {dataInputs.map((inp) => <li>{inp}</li>)}
        </ul>
      </div>
      <div class="io-out">
        <h2 class="text-sm meta">You get</h2>
        <ul>
          {outputs.map((out) => <li>{out}</li>)}
        </ul>
      </div>
    </section>

    <div class="body">
      <article class="prose-content">
        <Content />
      </article>

      <aside class="side">
        {usedIn.length > 0 && (
          <div>
            <h2 class="text-sm meta">Seen in</h2>
            {usedIn.slice(0, 6).map((s) => (
              <a href={`/case-studies/${s.id}`} class="side-row">
                <span>{s.data.city}</span>
                <span class="meta">{s.data.country}</span>
              </a>
            ))}
            {usedIn.length > 6 && (
              <a href="/case-studies" class="text-link">And {usedIn.length - 6} more case studies</a>
            )}
          </div>
        )}
        {tags.length > 0 && (
          <div>
            <h2 class="text-sm meta">Topics</h2>
            <p class="topics">{tags.join(' · ')}</p>
          </div>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="more">
        <div class="group-head">
          <h2>More for {categoryLabel(category).toLowerCase()}</h2>
          <a href={`/tools?cat=${category}`} class="text-link">See all</a>
        </div>
        {related.map((t) => (
          <a href={`/tools/${t.id}`} class="row">
            <span>
              <span class="row-title">{t.data.title}</span>
              <span class="row-sub block">{t.data.tagline}</span>
            </span>
            <span class="meta">{difficultyLabel(t.data.difficulty)}</span>
            <span class="meta">{licenseSummary(t.data.license)}</span>
          </a>
        ))}
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .head { padding-top: 2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .sheet-link { text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 4px; }
  .sheet-link:hover { text-decoration-color: var(--accent); }

  .io {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem 4rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .io ul { margin-top: 0.75rem; }
  .io li {
    padding: 0.625rem 0;
    border-top: 1px solid var(--rule);
    font-size: 1.0625rem;
  }
  .io-out li { color: var(--green); }

  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem 5rem;
    padding: 3.5rem 0 1rem;
  }
  .body article { flex: 999 1 34rem; min-width: 0; max-width: 46rem; }
  .side { flex: 1 1 16rem; min-width: 0; display: flex; flex-direction: column; gap: 2.5rem; }
  .side-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .side-row:first-of-type { margin-top: 0.5rem; border-top: 1px solid var(--rule); }
  .side-row:hover { border-bottom-color: var(--accent); }
  .topics { margin-top: 0.75rem; color: var(--ink-2); }

  .more { padding-bottom: 6rem; }
  .more .group-head { align-items: center; }
</style>
