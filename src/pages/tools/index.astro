---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabel, licenseSummary, difficultyLabel } from '../../lib/labels.mjs';

const allTools = (await getCollection('tools')).sort((a, b) => a.data.title.localeCompare(b.data.title));

const categoryOrder = ['heat', 'flood', 'coastal', 'green', 'data', 'planning'];
const groups = categoryOrder.map((cat, i) => ({
  cat,
  num: String(i + 1).padStart(2, '0'),
  label: categoryLabel(cat),
  tools: allTools.filter((t) => t.data.category === cat),
}));

const openLicensed = allTools.filter((t) => t.data.license !== 'Free-to-use').length;
const difficulties = ['beginner', 'intermediate', 'advanced'];
---

<BaseLayout title="Tools" description={`${allTools.length} free urban climate tools for heat, flooding, coasts, green infrastructure, climate data and planning.`}>
  <div class="page">

    <header class="page-head">
      <p class="section-label">The index</p>
      <h1>Tools, sorted by the problem in front of you.</h1>
      <p class="lede">
        {allTools.length} tools, all free to use; {openLicensed} carry an open licence.
        Each entry says what you need to bring and what you get back.
      </p>
    </header>

    <div class="controls">
      <div class="tabs" role="group" aria-label="Filter by challenge">
        <button type="button" class="tab" data-filter-cat="all" aria-pressed="true">All</button>
        {groups.map((g) => (
          <button type="button" class="tab" data-filter-cat={g.cat} aria-pressed="false">{g.label}</button>
        ))}
      </div>
      <div class="fields">
        <input id="tool-search" type="search" placeholder="Search tools" class="input" aria-label="Search tools" />
        <select id="filter-difficulty" class="input" aria-label="Filter by difficulty">
          <option value="all">Any level</option>
          {difficulties.map((d) => <option value={d}>{difficultyLabel(d)}</option>)}
        </select>
        <p class="meta" id="tool-count" aria-live="polite">{allTools.length} tools</p>
      </div>
    </div>

    {groups.map((g) => (
      <section class="tool-group" data-group={g.cat}>
        <div class="group-head">
          <span class="meta">{g.num}</span>
          <h2>{g.label}</h2>
          <span class="meta"><span data-group-count>{g.tools.length}</span> tools</span>
        </div>
        {g.tools.map((tool) => (
          <a
            href={`/tools/${tool.id}`}
            class="row tool-item"
            data-cat={tool.data.category}
            data-difficulty={tool.data.difficulty}
            data-title={tool.data.title.toLowerCase()}
            data-tags={`${tool.data.tags.join(' ')} ${tool.data.tagline}`.toLowerCase()}
          >
            <span>
              <span class="row-title">{tool.data.title}</span>
              <span class="row-sub block">{tool.data.tagline}</span>
            </span>
            <span class="meta">{difficultyLabel(tool.data.difficulty)}</span>
            <span class="meta">{licenseSummary(tool.data.license)}</span>
          </a>
        ))}
      </section>
    ))}

    <p id="no-results" class="no-results" hidden>
      Nothing matches those filters.
      <button type="button" class="text-link" id="reset-filters">Clear filters</button>
    </p>

  </div>
</BaseLayout>

<style>
  .controls {
    position: sticky;
    top: 3.5rem;
    z-index: 10;
    background: var(--bg);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 0.25rem 0 0.75rem;
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.5rem;
  }
  .fields .input { width: auto; flex: 0 1 14rem; min-height: 2.75rem; }
  .fields .meta { margin-left: auto; }
  .tool-group[hidden], .tool-item[hidden] { display: none; }
  .tool-group:first-of-type .group-head { margin-top: 2.5rem; }
  .no-results { padding: 4rem 0; color: var(--ink-2); }
  .page { padding-bottom: 6rem; }
  @media (max-width: 640px) {
    .controls { position: static; }
  }
</style>

<script>
  const searchEl = document.getElementById('tool-search') as HTMLInputElement;
  const diffEl = document.getElementById('filter-difficulty') as HTMLSelectElement;
  const countEl = document.getElementById('tool-count')!;
  const noResultsEl = document.getElementById('no-results')!;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.tool-item'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.tool-group'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-cat]'));

  let activeCat = 'all';

  function applyFilters() {
    const q = searchEl.value.trim().toLowerCase();
    const diff = diffEl.value;
    let visible = 0;

    items.forEach((el) => {
      const show =
        (activeCat === 'all' || el.dataset.cat === activeCat) &&
        (diff === 'all' || el.dataset.difficulty === diff) &&
        (!q || el.dataset.title!.includes(q) || el.dataset.tags!.includes(q));
      el.hidden = !show;
      if (show) visible++;
    });

    groups.forEach((g) => {
      const n = g.querySelectorAll('.tool-item:not([hidden])').length;
      g.hidden = n === 0;
      const c = g.querySelector('[data-group-count]');
      if (c) c.textContent = String(n);
    });

    countEl.textContent = `${visible} tool${visible !== 1 ? 's' : ''}`;
    noResultsEl.hidden = visible > 0;
  }

  function setCat(cat: string) {
    activeCat = tabs.some((t) => t.dataset.filterCat === cat) ? cat : 'all';
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.filterCat === activeCat)));
    applyFilters();
  }

  tabs.forEach((t) => t.addEventListener('click', () => setCat(t.dataset.filterCat!)));
  searchEl.addEventListener('input', applyFilters);
  diffEl.addEventListener('change', applyFilters);
  document.getElementById('reset-filters')?.addEventListener('click', () => {
    searchEl.value = '';
    diffEl.value = 'all';
    setCat('all');
  });

  // Init from ?cat= URL param
  setCat(new URLSearchParams(window.location.search).get('cat') ?? 'all');
</script>
