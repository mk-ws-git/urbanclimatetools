---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  ['/tools',        'Tools',        'The full index, sorted by problem'],
  ['/case-studies', 'Case studies', 'What cities have actually done'],
  ['/data',         'Data',         'Context, sources and downloads'],
];
---

<BaseLayout title="Page not found" description="The page you were looking for doesn’t exist.">
  <div class="page">
    <header class="page-head">
      <p class="section-label">Error 404</p>
      <h1>This page is off the map.</h1>
      <p class="lede">
        It doesn’t exist or it has moved. Try the search, or start from one of the sections below.
      </p>
      <div class="actions">
        <a href="/" class="btn-primary">Back to the start</a>
        <a href="/search" class="btn-secondary">Search the site</a>
      </div>
    </header>

    <nav class="links" aria-label="Main sections">
      {links.map(([href, title, desc]) => (
        <a href={href} class="row two">
          <span class="row-title">{title}</span>
          <span class="row-sub">{desc}</span>
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .links { border-top: 2px solid var(--ink); margin-bottom: 6rem; }
  @media (min-width: 768px) {
    .row.two { grid-template-columns: 14rem minmax(0, 1fr); }
  }
</style>
