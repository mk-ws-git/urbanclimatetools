---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn’t exist.">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-28 text-center">
    <p class="section-label mb-3">Error 404</p>
    <h1 class="text-4xl font-bold text-stone-900 dark:text-stone-100 sm:text-5xl">
      Page not found
    </h1>
    <p class="mt-4 text-stone-500 dark:text-stone-400 leading-relaxed">
      The page you’re looking for doesn’t exist or may have moved. Try searching, or head back to one of the main sections below.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary px-5 py-2.5">Back to home</a>
      <a href="/search" class="btn-secondary px-5 py-2.5">Search the site</a>
    </div>

    <div class="mt-12 grid gap-3 sm:grid-cols-3 text-left">
      {[
        ['/tools',        'Tools',        'Browse the full tool library'],
        ['/case-studies', 'Case Studies', 'Global implementations'],
        ['/data',         'Data',         'Climate context & metrics'],
      ].map(([href, title, desc]) => (
        <a href={href} class="card-hover p-4">
          <p class="font-medium text-stone-800 dark:text-stone-200 text-sm">{title}</p>
          <p class="mt-0.5 text-xs text-stone-400">{desc}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
