---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools    = await getCollection('tools');
const allStudies  = await getCollection('case-studies');
---

<BaseLayout title="About" description="About Urban Climate Tools — an open-source repository of tools and case studies for climate-resilient urban planning.">

  <div class="bg-stone-50 dark:bg-stone-900 border-b border-stone-200 dark:border-stone-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
      <p class="section-label mb-2">About</p>
      <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100">Urban Climate Tools</h1>
      <p class="mt-2 text-stone-500 dark:text-stone-400 max-w-2xl">
        An open repository connecting practitioners with the tools they need to build climate-resilient cities.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-14 space-y-14">

    <section>
      <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100 mb-4">What this is</h2>
      <div class="prose-content text-stone-600 dark:text-stone-400 space-y-4 text-sm leading-relaxed">
        <p>Urban Climate Tools is a curated, open-source repository of free tools, datasets, and real-world implementation case studies for urban climate practitioners — including city planners, climate officers, researchers, engineers, and community advocates.</p>
        <p>The project grew from a frustration shared by many in the field: the tools exist, the knowledge exists, but they're scattered across GitHub repositories, academic papers, NGO websites, and agency portals with no common entry point. This site is that entry point.</p>
        <p>Everything here is free to use. All tools are open-source or freely available. All case studies reference publicly available sources. The code for this site is MIT-licensed on GitHub.</p>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100 mb-4">Scope</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Tools indexed',  `${allTools.length} tools across 6 challenge areas`],
          ['Case studies',   `${allStudies.length} implementations across 6 continents`],
          ['Licence model',  'All tools are open-source or freely available'],
          ['Update cadence', 'New tools and case studies added via GitHub PRs'],
        ].map(([k, v]) => (
          <div class="card">
            <p class="text-xs text-stone-400 mb-1">{k}</p>
            <p class="text-sm font-medium text-stone-700 dark:text-stone-300">{v}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100 mb-4">Contribute</h2>
      <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed mb-6">
        Urban Climate Tools is maintained through community contributions. If you know of a tool or case study that should be here, or if you spot an error in an existing entry, please open a pull request or an issue on GitHub. Contribution guidelines are in <code class="rounded bg-stone-100 dark:bg-stone-800 px-1 py-0.5 text-xs">CONTRIBUTING.md</code>.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/mk-ws-git/urbanclimatetools" target="_blank" rel="noreferrer" class="btn-primary">
          View on GitHub
        </a>
        <a href="https://github.com/mk-ws-git/urbanclimatetools/issues/new" target="_blank" rel="noreferrer" class="btn-secondary">
          Open an issue
        </a>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100 mb-4">Built with</h2>
      <div class="flex flex-wrap gap-3">
        {['Astro', 'Tailwind CSS v4', 'MDX', 'Leaflet', 'Pagefind'].map((tech) => (
          <span class="rounded-lg border border-stone-200 dark:border-stone-700 px-3 py-1.5 text-sm text-stone-600 dark:text-stone-400">
            {tech}
          </span>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
