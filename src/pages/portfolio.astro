---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCatalogStats } from '../lib/catalog';

const allTools   = await getCollection('tools');
const allStudies = await getCollection('case-studies');
const stats      = await getCatalogStats();
const categoryCount = Object.keys(stats.categoryCounts).length;

const techStack = [
  { name: 'Astro 6',          role: 'Static site framework: zero JS by default, islands for the interactive parts' },
  { name: 'Tailwind CSS v4',  role: 'CSS-native design tokens shared by the light and dark themes' },
  { name: 'Content Collections + Zod', role: 'Every tool and case study is a typed Markdown file validated at build time' },
  { name: 'Leaflet',          role: 'Interactive maps for the case studies' },
  { name: 'Pagefind',         role: 'Static full-text search indexed at build time, no server needed' },
  { name: 'Build-time OG images', role: 'A script generates a share card for every page so links unfurl well' },
];

const metrics = [
  { value: `${allTools.length}`,      label: 'tools catalogued' },
  { value: `${allStudies.length}`,    label: 'case studies written' },
  { value: `${categoryCount}`,        label: 'challenge areas' },
  { value: `${stats.countryCount}`,   label: 'countries' },
  { value: `${stats.continentCount}`, label: 'continents' },
];

const highlights = [
  {
    title: 'Content-driven static platform',
    body: 'Designed and built end to end: content model and schema, counts and filters derived from a single source of truth, frontend, search and build-time OG images. The site code is open source under the MIT licence.',
  },
  {
    title: 'The city as index',
    body: 'The homepage is an axonometric city block generated from code. Each part of the drawing opens the tools and the case study that apply to it, read from the same content files as the rest of the site.',
  },
  {
    title: 'Equity-informed content strategy',
    body: 'Case studies deliberately span 6 continents and foreground equity considerations (Bogotá, Dhaka, Lagos, Medellín), not just the usual European city examples.',
  },
  {
    title: 'Performance-first architecture',
    body: 'Static Astro output with no client-side framework; JavaScript only for the interactive islands (city index, tool finder, maps, filters). Self-hosted fonts, hosted on a global CDN.',
  },
];

const pipeline = [
  { step: '01', name: 'Content layer', lines: ['Markdown files', `${allTools.length} tools · ${allStudies.length} case studies`, 'Zod schema validation', 'Derived counts and filters'] },
  { step: '02', name: 'Astro build',   lines: ['Static HTML and CSS', 'City index, tool finder and maps as islands', 'Pagefind search index', 'Per-page OG images'] },
  { step: '03', name: 'Hosting',       lines: ['Cloudflare Pages', 'Deploys from GitHub', 'CDN and HTTPS'] },
];

const samples = [
  ...allTools.filter((t) => t.data.featured).slice(0, 3).map((t) => ({ href: `/tools/${t.id}`, title: t.data.title, sub: t.data.tagline })),
  ...allStudies.filter((s) => s.data.featured).slice(0, 3).map((s) => ({ href: `/case-studies/${s.id}`, title: `${s.data.city}: ${s.data.title}`, sub: s.data.tagline })),
];
---

<BaseLayout
  title="Portfolio"
  description="How Urban Climate Tools was built: a catalogue of urban climate tools and case studies made with Astro, Tailwind CSS, Pagefind and Leaflet."
>
  <div class="page">

    <header class="page-head">
      <p class="section-label">Portfolio project</p>
      <h1 class="wide">How Urban Climate Tools was built.</h1>
      <p class="lede">
        A catalogue and discovery platform for urban climate practitioners, covering tools, case studies and data
        across six challenge areas. Designed and built from scratch by Mary Sprague.
      </p>
      <div class="actions">
        <a href="https://github.com/mk-ws-git/urbanclimatetools" target="_blank" rel="noreferrer" class="btn-primary">GitHub repository</a>
        <a href="/" class="btn-secondary">Live site</a>
      </div>
    </header>

    <dl class="counts">
      {metrics.map(({ value, label }) => (
        <div><dd>{value}</dd><dt>{label}</dt></div>
      ))}
    </dl>

    <div class="group-head"><h2>What I built</h2><span class="meta">Scope</span></div>
    <div class="two-col">
      {highlights.map(({ title, body }) => (
        <div class="item">
          <h3>{title}</h3>
          <p>{body}</p>
        </div>
      ))}
    </div>

    <div class="group-head"><h2>System overview</h2><span class="meta">Architecture</span></div>
    <ol class="pipeline">
      {pipeline.map((p) => (
        <li>
          <span class="meta">{p.step}</span>
          <h3>{p.name}</h3>
          <ul>{p.lines.map((l) => <li>{l}</li>)}</ul>
        </li>
      ))}
    </ol>

    <div class="group-head"><h2>Tech stack</h2><span class="meta">Technology</span></div>
    {techStack.map(({ name, role }) => (
      <div class="row two">
        <span class="row-title">{name}</span>
        <span class="row-sub">{role}</span>
      </div>
    ))}

    <div class="group-head"><h2>Sample content</h2><span class="meta">Deliverables</span></div>
    {samples.map((s) => (
      <a href={s.href} class="row two">
        <span class="row-title">{s.title}</span>
        <span class="row-sub">{s.sub}</span>
      </a>
    ))}

    <section class="contact">
      <div>
        <h2>Interested in this work?</h2>
        <p>Open to climate tech, urban data and civic tech opportunities.</p>
      </div>
      <div class="actions">
        <a href="mailto:maryksprague@gmail.com" class="btn-primary">Get in touch</a>
        <a href="https://github.com/mk-ws-git/urbanclimatetools" target="_blank" rel="noreferrer" class="btn-secondary">GitHub</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .counts { display: flex; flex-wrap: wrap; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .counts > div { flex: 1 1 9rem; padding: 1.5rem 1.5rem 1.5rem 0; }
  .counts dd { font-family: var(--font-mono); font-size: 2.5rem; line-height: 1.1; }
  .counts dt { margin-top: 0.375rem; color: var(--ink-2); }

  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 2rem 4rem; margin-top: 1rem; }
  .item h3 { font-size: 1.25rem; font-weight: 500; }
  .item p { margin-top: 0.5rem; color: var(--ink-2); }

  .pipeline { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 2rem; margin-top: 1rem; }
  .pipeline > li { border-top: 1px solid var(--accent); padding-top: 1rem; }
  .pipeline h3 { margin-top: 0.25rem; font-family: var(--font-display); font-size: 1.75rem; line-height: 1.1; }
  .pipeline ul { margin-top: 0.75rem; }
  .pipeline ul li { padding: 0.5rem 0; border-top: 1px solid var(--rule); color: var(--ink-2); }

  @media (min-width: 768px) {
    .row.two { grid-template-columns: 20rem minmax(0, 1fr); }
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin: 5rem 0 6rem;
    padding: 2rem 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .contact p { margin-top: 0.5rem; color: var(--ink-2); }
  .contact .actions { margin-top: 0; }
</style>
