---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabel } from '../../lib/labels.mjs';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const {
  city, country, continent, title, tagline, themes, toolsUsed,
  population, year, impact, statValue, statLabel, image, imageAlt, imageCredit, imageCreditUrl, ogImage,
} = study.data;

// Hero photo comes from frontmatter (single source of truth).
const photo = image;
const hasStat = Boolean(statValue && statLabel);

const allStudies = await getCollection('case-studies');
const related = allStudies
  .filter((s) => s.id !== study.id && s.data.themes.some((t) => themes.includes(t)))
  .slice(0, 3);

// Real titles for the "Relevant tools" list (falls back to the slug if a tool is missing).
const toolTitles = new Map((await getCollection('tools')).map((t) => [t.id, t.data.title]));
const toolName = (slug: string) =>
  toolTitles.get(slug) ?? slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const resolvedOg = ogImage ?? `/og/case-studies-${study.id}.png`;
---

<BaseLayout title={`${city} — ${title}`} description={tagline} type="article" ogImage={resolvedOg}>
  <div class="page">

    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/case-studies">Case studies</a><span>/</span><span>{city}</span>
    </nav>

    <header class="page-head head">
      <p class="section-label">{city}, {country} · {themes.map((t) => categoryLabel(t)).join(' · ')}</p>
      <h1 class="wide">{title}</h1>
      <p class="lede">{tagline}</p>
    </header>

    <section class="lead" aria-label="Headline figure">
      <div class="lead-stat">
        <p class="meta">Headline figure</p>
        {hasStat ? (
          <>
            <p class="figure-stat big">{statValue}</p>
            <p class="lead-label">{statLabel}</p>
          </>
        ) : (
          <p class="lead-label">{impact}</p>
        )}
      </div>
      {photo && (
        <figure class="lead-photo">
          <img src={photo} alt={imageAlt ?? `${city} cityscape`} loading="eager" />
          {imageCredit && (
            <figcaption class="meta">
              {imageCreditUrl ? <a href={imageCreditUrl} target="_blank" rel="noreferrer">{imageCredit}</a> : imageCredit}
            </figcaption>
          )}
        </figure>
      )}
    </section>

    <dl class="sheet">
      <div><dt class="meta">Population</dt><dd>{population}</dd></div>
      <div><dt class="meta">Since</dt><dd>{String(year)}</dd></div>
      <div><dt class="meta">Region</dt><dd>{continent}</dd></div>
      <div><dt class="meta">Relevant tools</dt><dd>{toolsUsed.length}</dd></div>
    </dl>

    <div class="body">
      <article>
        <div class="impact">
          <p class="meta">Reported impact</p>
          <p class="impact-text">{impact}</p>
          <p class="impact-note">Figures reported by the city programme, checked against the published sources listed below.</p>
        </div>
        <div class="prose-content">
          <Content />
        </div>
      </article>

      <aside class="side">
        <div>
          <div id="mini-map" class="uct-map mini-map"></div>
          <p class="meta map-cap">{city}, {country}</p>
        </div>

        {toolsUsed.length > 0 && (
          <div>
            <h2 class="text-sm meta">Tools for this</h2>
            {toolsUsed.map((slug) => (
              <a href={`/tools/${slug}`} class="side-row">{toolName(slug)}</a>
            ))}
          </div>
        )}

        <div>
          <h2 class="text-sm meta">Challenges</h2>
          {themes.map((t) => (
            <a href={`/tools?cat=${t}`} class="side-row">{categoryLabel(t)}</a>
          ))}
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="more">
        <div class="group-head">
          <h2>Related case studies</h2>
          <a href="/case-studies" class="text-link">See all</a>
        </div>
        <div class="entry-grid">
          {related.map((s) => (
            <a href={`/case-studies/${s.id}`} class="entry">
              <span class="meta">{s.data.city}, {s.data.country}</span>
              {s.data.statValue && <span class="figure-stat">{s.data.statValue}</span>}
              {s.data.statLabel && <span class="entry-label">{s.data.statLabel}</span>}
              <span class="entry-title">{s.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .head { padding-top: 2rem; }

  .lead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem 4rem;
    padding-bottom: 3rem;
  }
  .lead-stat { flex: 1 1 20rem; min-width: 0; }
  .big { margin-top: 0.75rem; font-size: clamp(4.5rem, 13vw, 10rem); overflow-wrap: anywhere; }
  .lead-label { margin-top: 0.75rem; max-width: 26rem; font-size: 1.25rem; color: var(--ink-2); }
  .lead-photo { flex: 1 1 24rem; min-width: 0; max-width: 34rem; margin: 0; }
  .lead-photo img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    filter: grayscale(1) contrast(1.05);
  }
  .lead-photo figcaption { margin-top: 0.5rem; }
  .lead-photo a { text-decoration: underline; text-underline-offset: 3px; }

  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem 5rem;
    padding: 3.5rem 0 1rem;
  }
  .body article { flex: 999 1 34rem; min-width: 0; max-width: 46rem; }
  .impact {
    margin-bottom: 3rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--accent);
    border-bottom: 1px solid var(--rule);
  }
  .impact-text { margin-top: 0.75rem; font-size: 1.25rem; line-height: 1.5; }
  .impact-note { margin-top: 0.75rem; font-size: 0.875rem; color: var(--ink-3); }

  .side { flex: 1 1 16rem; min-width: 0; display: flex; flex-direction: column; gap: 2.5rem; }
  .mini-map {
    height: 11rem;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
  }
  .map-cap { margin-top: 0.5rem; }
  .side-row {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .side h2 + .side-row { margin-top: 0.5rem; border-top: 1px solid var(--rule); }
  .side-row:hover { border-bottom-color: var(--accent); }

  .more { padding-bottom: 6rem; }
  .more .group-head { align-items: center; margin-bottom: 1.5rem; }
</style>

<!-- Mini map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script define:vars={{ lat: study.data.lat, lng: study.data.lng, city }}>
  window.addEventListener('load', () => {
    const L = window.L;
    if (!L) return;
    const dark = document.documentElement.classList.contains('dark');
    const tileURL = dark
      ? 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}'
      : 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}';
    const map = L.map('mini-map', { zoomControl: false, dragging: false, scrollWheelZoom: false })
      .setView([lat, lng], 9);
    L.tileLayer(tileURL, { attribution: 'Tiles &copy; Esri', maxZoom: 16 }).addTo(map);
    L.circleMarker([lat, lng], { radius: 8, color: '#0F1714', fillColor: '#F2A65A', fillOpacity: 1, weight: 2 })
      .addTo(map).bindPopup(city);
  });
</script>
