---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { categoryLabel } from '../../lib/labels.mjs';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const {
  city, country, continent, title, tagline, themes, toolsUsed,
  population, year, impact, statValue, statLabel, featured, image, imageAlt, ogImage,
} = study.data;

// Hero photo now comes from frontmatter (single source of truth). Studies without an
// image fall back to the gradient hero below.
const photo = image;
const hasStat = Boolean(statValue && statLabel);

const allStudies = await getCollection('case-studies');
const related = allStudies
  .filter((s) => s.id !== study.id && s.data.themes.some((t) => themes.includes(t)))
  .slice(0, 6);

const resolvedOg = ogImage ?? `/og/case-studies-${study.id}.png`;
---

<BaseLayout title={`${city} — ${title}`} description={tagline} type="article" ogImage={resolvedOg}>

  <!-- Hero: city photo with bottom-anchored title -->
  <div class="relative bg-forest-950 text-white overflow-hidden flex flex-col justify-end min-h-[420px]">
    {photo && (
      <>
        <img src={photo} alt={imageAlt ?? `${city} cityscape`}
          class="absolute inset-0 h-full w-full object-cover opacity-40" aria-hidden="true" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-950 via-forest-950/55 to-transparent"></div>
      </>
    )}
    {!photo && (
      <div class="absolute inset-0 bg-gradient-to-br from-forest-700 via-forest-950 to-forest-950"></div>
    )}
    <!-- Breadcrumb -->
    <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-8">
      <nav class="flex items-center gap-2 text-xs text-stone-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/case-studies" class="hover:text-white transition-colors">Case Studies</a>
        <span>/</span>
        <span class="text-stone-300">{city}</span>
      </nav>
    </div>
    <!-- Title block -->
    <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pb-12 pt-6">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white backdrop-blur">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M8 1.5C5.2 1.5 3 3.7 3 6.5c0 3.5 5 8 5 8s5-4.5 5-8c0-2.8-2.2-5-5-5z" stroke-linejoin="round"/>
            <circle cx="8" cy="6.5" r="1.6"/>
          </svg>
          {city}, {country}
        </span>
        {themes.map((t) => (
          <span class="badge category-chip" data-cat={t}>{t}</span>
        ))}
        {featured && <span class="badge bg-amber-900/60 text-amber-300">Featured</span>}
      </div>
      <h1 class="text-3xl font-bold sm:text-4xl max-w-3xl">{title}</h1>
      <p class="mt-3 text-stone-300 text-lg max-w-2xl">{tagline}</p>
    </div>
  </div>

  <!-- ============ FACT SHEET: Key facts panel ============ -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 -mt-6 relative z-20">
    <div class="card p-0 overflow-hidden shadow-md">
      <div class="grid md:grid-cols-[minmax(0,1.1fr)_minmax(0,2fr)]">

        <!-- Headline impact stat — the single most important figure -->
        <div class="flex flex-col justify-center p-6 bg-forest-500 text-white">
          <div class="text-[11px] font-semibold uppercase tracking-widest text-forest-50/80 mb-1">Headline impact</div>
          {hasStat ? (
            <>
              <div class="text-4xl sm:text-5xl font-bold leading-none tracking-tight">{statValue}</div>
              <div class="mt-2 text-sm text-forest-50/90 leading-snug">{statLabel}</div>
            </>
          ) : (
            <div class="text-lg font-semibold leading-snug">{impact}</div>
          )}
        </div>

        <!-- Facts grid -->
        <dl class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y divide-stone-200 dark:divide-stone-800 border-t md:border-t-0 md:border-l border-stone-200 dark:border-stone-800">
          <div class="p-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500 mb-1">Population</dt>
            <dd class="text-sm font-semibold text-stone-800 dark:text-stone-100">{population}</dd>
          </div>
          <div class="p-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500 mb-1">Since</dt>
            <dd class="text-sm font-semibold text-stone-800 dark:text-stone-100">{String(year)}</dd>
          </div>
          <div class="p-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500 mb-1">Region</dt>
            <dd class="text-sm font-semibold text-stone-800 dark:text-stone-100">{continent}</dd>
          </div>
          <div class="p-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-stone-400 dark:text-stone-500 mb-1">Tools used</dt>
            <dd class="text-sm font-semibold text-forest-700 dark:text-forest-300">{toolsUsed.length}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Body -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 lg:grid-cols-3">

      <!-- Article -->
      <article class="lg:col-span-2">

        <!-- Verified impact callout — full sourced statement -->
        <div class="mb-8 rounded-xl overflow-hidden border border-forest-200 dark:border-forest-800">
          <div class="bg-forest-500 px-5 py-2.5 flex items-center gap-2">
            <svg class="h-4 w-4 text-white shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 1l1.94 4.02L14 5.68l-3 2.92.71 4.12L8 10.6l-3.71 2.12.71-4.12L2 5.68l4.06-.66L8 1z"/>
            </svg>
            <span class="text-xs font-semibold uppercase tracking-wider text-white">Reported impact</span>
          </div>
          <div class="bg-forest-50 dark:bg-forest-950/40 px-5 py-4">
            <p class="text-stone-700 dark:text-stone-300 text-sm leading-relaxed">{impact}</p>
            <p class="mt-2 flex items-center gap-1.5 text-xs text-stone-500 dark:text-stone-400">
              <svg class="h-3 w-3 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M8 5v3.5M8 11h.01M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Figures reported by the city programme, verified against published case-study sources.
            </p>
          </div>
        </div>

        <div class="prose-content">
          <Content />
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5">

        <!-- Map -->
        <div class="card overflow-hidden p-0">
          <div id="mini-map" class="uct-map h-44 w-full bg-stone-100 dark:bg-stone-800"></div>
          <div class="px-4 py-3 text-sm text-stone-500 dark:text-stone-400">{city}, {country}</div>
        </div>

        <!-- Tools used -->
        {toolsUsed.length > 0 && (
          <div class="card">
            <h2 class="text-sm font-semibold text-stone-700 dark:text-stone-300 mb-3">
              Tools used
              <span class="ml-1.5 rounded-full bg-forest-100 dark:bg-forest-900 px-1.5 py-0.5 text-xs font-medium text-forest-700 dark:text-forest-300">{toolsUsed.length}</span>
            </h2>
            <ul class="space-y-2">
              {toolsUsed.map((slug) => (
                <li>
                  <a href={`/tools/${slug}`}
                    class="group flex items-center justify-between rounded-lg border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800/50 px-3 py-2.5 text-sm hover:border-forest-400 hover:bg-forest-50 dark:hover:bg-forest-950/60 transition-colors">
                    <span class="font-medium text-stone-700 dark:text-stone-300 group-hover:text-forest-700 dark:group-hover:text-forest-300 transition-colors">
                      {slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}
                    </span>
                    <svg class="h-3.5 w-3.5 shrink-0 text-stone-400 group-hover:text-forest-500 transition-colors" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Themes -->
        <div class="card">
          <h2 class="text-sm font-semibold text-stone-700 dark:text-stone-300 mb-3">Challenge themes</h2>
          <div class="flex flex-wrap gap-1.5">
            {themes.map((t) => (
              <a href={`/tools?cat=${t}`} class="badge category-chip" data-cat={t}>{t}</a>
            ))}
          </div>
        </div>

      </aside>
    </div>

    <!-- Related carousel -->
    {related.length > 0 && (
      <section class="mt-16 border-t border-stone-200 dark:border-stone-800 pt-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100">Related case studies</h2>
          <div class="flex gap-2">
            <button id="cs-prev" aria-label="Previous"
              class="rounded-full border border-stone-200 dark:border-stone-700 p-2 text-stone-500 hover:text-stone-800 dark:hover:text-stone-200 hover:border-stone-300 dark:hover:border-stone-500 transition-colors">
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M10 12L6 8l4-4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button id="cs-next" aria-label="Next"
              class="rounded-full border border-stone-200 dark:border-stone-700 p-2 text-stone-500 hover:text-stone-800 dark:hover:text-stone-200 hover:border-stone-300 dark:hover:border-stone-500 transition-colors">
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
        <div id="cs-carousel"
          class="flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide pb-2">
          {related.map((s) => (
            <div class="shrink-0 w-80 snap-start">
              <CaseStudyCard study={s} monochrome />
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

</BaseLayout>

<!-- Mini map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script define:vars={{ lat: study.data.lat, lng: study.data.lng, city }}>
  window.addEventListener('load', () => {
    const L = window.L;
    if (!L) return;
    const prefersDark = document.documentElement.classList.contains('dark');
    const tileURL = prefersDark
      ? 'https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png'
      : 'https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png';
    const map = L.map('mini-map', { zoomControl: false, dragging: false, scrollWheelZoom: false })
      .setView([lat, lng], 9);
    L.tileLayer(tileURL, { attribution: '', maxZoom: 19 }).addTo(map);
    L.circleMarker([lat, lng], { radius: 8, color: '#168A66', fillColor: '#1D9E75', fillOpacity: 0.9, weight: 2 })
      .addTo(map).bindPopup(city);
  });
</script>
<script>
  const track = document.getElementById('cs-carousel');
  const prev  = document.getElementById('cs-prev');
  const next  = document.getElementById('cs-next');
  if (track && prev && next) {
    const step = 336;
    prev.addEventListener('click', () => track.scrollBy({ left: -step, behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left:  step, behavior: 'smooth' }));
  }
</script>
