---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyMap from '../../components/CaseStudyMap.astro';
import { categoryLabel } from '../../lib/labels.mjs';

const allStudies = (await getCollection('case-studies')).sort((a, b) => a.data.city.localeCompare(b.data.city));

const continents = ['Africa', 'Asia', 'Europe', 'North America', 'South America', 'Oceania']
  .filter((c) => allStudies.some((s) => s.data.continent === c));
const themes = ['heat', 'flood', 'coastal', 'green', 'data', 'planning'];
const countryCount = new Set(allStudies.map((s) => s.data.country)).size;
const slug = (c: string) => c.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout title="Case Studies" description={`Explore ${allStudies.length} case studies showing how cities around the world have adapted to heat, flooding and sea-level rise.`}>
  <div class="page">

    <header class="page-head">
      <p class="section-label">The evidence</p>
      <h1>What cities have actually done.</h1>
      <p class="lede">
        {allStudies.length} cities in {countryCount} countries. Each entry leads with one sourced figure,
        then the project, the lessons and the tools that apply.
      </p>
    </header>

    <CaseStudyMap studies={allStudies} />

    <div class="controls">
      <div class="tabs" role="group" aria-label="Filter by continent">
        <button type="button" class="tab" data-filter-continent="all" aria-pressed="true">Everywhere</button>
        {continents.map((c) => (
          <button type="button" class="tab" data-filter-continent={slug(c)} aria-pressed="false">{c}</button>
        ))}
      </div>
      <div class="fields">
        <input id="cs-search" type="search" placeholder="Search cities" class="input" aria-label="Search case studies by city, country or title" />
        <select id="filter-theme" class="input" aria-label="Filter by theme">
          <option value="all">Any challenge</option>
          {themes.map((t) => <option value={t}>{categoryLabel(t)}</option>)}
        </select>
        <p class="meta" id="cs-count" aria-live="polite">{allStudies.length} case studies</p>
      </div>
    </div>

    <div class="entry-grid" id="cs-grid">
      {allStudies.map((s) => (
        <a
          href={`/case-studies/${s.id}`}
          class="entry cs-item"
          data-continent={slug(s.data.continent)}
          data-themes={s.data.themes.join(' ')}
          data-text={`${s.data.city} ${s.data.country} ${s.data.title}`.toLowerCase()}
        >
          <span class="meta">{s.data.city}, {s.data.country}</span>
          {s.data.statValue && <span class="figure-stat">{s.data.statValue}</span>}
          {s.data.statLabel && <span class="entry-label">{s.data.statLabel}</span>}
          <span class="entry-title">{s.data.title}</span>
          <span class="meta themes">{s.data.themes.map((t) => categoryLabel(t)).join(' · ')}</span>
        </a>
      ))}
    </div>

    <p id="cs-no-results" class="no-results" hidden>
      No case studies match those filters.
      <button type="button" class="text-link" id="cs-reset">Clear filters</button>
    </p>

  </div>
</BaseLayout>

<style>
  .page { padding-bottom: 6rem; }
  .controls {
    margin: 2.5rem 0 3rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 0.25rem 0 0.75rem;
  }
  .fields { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: 0.5rem; }
  .fields .input { width: auto; flex: 0 1 14rem; min-height: 2.75rem; }
  .fields .meta { margin-left: auto; }
  .cs-item[hidden] { display: none; }
  .themes { margin-top: 0.25rem; }
  .no-results { padding: 4rem 0; color: var(--ink-2); }
</style>

<script>
  const themeEl = document.getElementById('filter-theme') as HTMLSelectElement;
  const searchEl = document.getElementById('cs-search') as HTMLInputElement;
  const countEl = document.getElementById('cs-count')!;
  const noResultsEl = document.getElementById('cs-no-results')!;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.cs-item'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-continent]'));
  let activeContinent = 'all';

  function applyFilters() {
    const theme = themeEl.value;
    const q = searchEl.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((el) => {
      const show =
        (activeContinent === 'all' || el.dataset.continent === activeContinent) &&
        (theme === 'all' || el.dataset.themes!.split(' ').includes(theme)) &&
        (!q || el.dataset.text!.includes(q));
      el.hidden = !show;
      if (show) visible++;
    });
    countEl.textContent = `${visible} case stud${visible !== 1 ? 'ies' : 'y'}`;
    noResultsEl.hidden = visible > 0;
  }

  function setContinent(c: string) {
    activeContinent = c;
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.filterContinent === c)));
    applyFilters();
  }

  tabs.forEach((t) => t.addEventListener('click', () => setContinent(t.dataset.filterContinent!)));
  themeEl.addEventListener('change', applyFilters);
  searchEl.addEventListener('input', applyFilters);
  document.getElementById('cs-reset')?.addEventListener('click', () => {
    themeEl.value = 'all';
    searchEl.value = '';
    setContinent('all');
  });
</script>
