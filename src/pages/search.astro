---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every tool, case study and page on Urban Climate Tools.">
  <div class="page">
    <header class="page-head">
      <p class="section-label">Search</p>
      <h1>Find a tool, a city or a topic.</h1>
    </header>

    <div id="search" class="search"></div>
  </div>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script>
  window.addEventListener('load', () => {
    if (typeof (window as any).PagefindUI !== 'undefined') {
      new (window as any).PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
      });
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) {
        const input = document.querySelector('#search input') as HTMLInputElement;
        if (input) { input.value = q; input.dispatchEvent(new Event('input')); }
      }
    }
  });
</script>

<style is:global>
  .search {
    max-width: 48rem;
    padding-bottom: 6rem;
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--ink-3);
    --pagefind-ui-tag: var(--rule);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__result { padding: 1.5rem 0; border-top: 1px solid var(--rule); }
  #search .pagefind-ui__result-link {
    color: var(--ink);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }
  #search .pagefind-ui__result-link:hover { text-decoration-color: var(--accent); }

  /* Kind label above each top-level result, derived from its URL */
  #search .pagefind-ui__result-inner > .pagefind-ui__result-title > .pagefind-ui__result-link::before {
    content: 'Page';
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  #search .pagefind-ui__result-inner > .pagefind-ui__result-title > .pagefind-ui__result-link[href^='/tools/']::before { content: 'Tool'; }
  #search .pagefind-ui__result-inner > .pagefind-ui__result-title > .pagefind-ui__result-link[href^='/case-studies/']::before { content: 'Case study'; }
  #search .pagefind-ui__result-excerpt,
  #search .pagefind-ui__message { color: var(--ink-2); }
  #search .pagefind-ui__message {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  #search .pagefind-ui__result-nested .pagefind-ui__result-link { font-size: 1rem; }
  #search mark {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #search .pagefind-ui__search-input { font-weight: 500; }
  #search .pagefind-ui__search-input::placeholder { color: var(--ink-3); opacity: 1; }
  #search .pagefind-ui__button {
    border: 1px solid var(--ink-3);
    background: transparent;
    color: var(--ink);
    font-weight: 500;
  }
  #search .pagefind-ui__button:hover { border-color: var(--accent); }
</style>
