---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every tool, case study and page on Urban Climate Tools.">
  <div class="page">
    <header class="page-head">
      <p class="section-label">Search</p>
      <h1>Find a tool, a city or a topic.</h1>
    </header>

    <div id="search" class="search"></div>
  </div>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script>
  window.addEventListener('load', () => {
    if (typeof (window as any).PagefindUI !== 'undefined') {
      new (window as any).PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
      });
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) {
        const input = document.querySelector('#search input') as HTMLInputElement;
        if (input) { input.value = q; input.dispatchEvent(new Event('input')); }
      }
    }
  });
</script>

<style is:global>
  .search {
    max-width: 48rem;
    padding-bottom: 6rem;
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--ink-3);
    --pagefind-ui-tag: var(--rule);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-sans);
  }
  .search .pagefind-ui__result-link { color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 4px; }
  .search .pagefind-ui__result-excerpt, .search .pagefind-ui__message { color: var(--ink-2); }
  .search mark { background: var(--accent-solid); color: var(--on-accent); }
  .search .pagefind-ui__search-input::placeholder { color: var(--ink-3); opacity: 1; }
</style>
