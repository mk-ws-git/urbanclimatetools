---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataExplorer from '../components/DataExplorer.astro';
import { getCatalogStats } from '../lib/catalog';

const stats = await getCatalogStats();

const sources = [
  ['IPCC AR6 (2021–2022)', 'Global climate projections and risk frameworks'],
  ['NOAA / NASA GISS',     'Observed temperature anomalies and trend data'],
  ['C40 Cities',           'Urban climate action and city reach estimates'],
  ['World Bank',           'Urban flood exposure and infrastructure financing data'],
  ['OECD',                 'Green infrastructure return on investment meta-analysis'],
];
---

<BaseLayout title="Data" description="The numbers behind Urban Climate Tools: climate context, how the catalogue breaks down, where figures come from, and the full catalogue as open data.">
  <div class="page">

    <header class="page-head">
      <p class="section-label">The numbers</p>
      <h1>Where the figures come from.</h1>
      <p class="lede">
        The context behind the catalogue, how it breaks down, and the whole thing as a download.
      </p>
    </header>

    <DataExplorer />

    <div class="group-head">
      <h2>The catalogue in numbers</h2>
      <span class="meta">Counted at build time</span>
    </div>
    <dl class="counts">
      <div><dd>{stats.toolCount}</dd><dt>tools indexed</dt></div>
      <div><dd>{stats.caseStudyCount}</dd><dt>case studies</dt></div>
      <div><dd>{stats.countryCount}</dd><dt>countries</dt></div>
      <div><dd>{stats.continentCount}</dd><dt>continents</dt></div>
    </dl>

    <div class="group-head">
      <h2>Sources and method</h2>
    </div>
    <p class="para">
      Climate metrics are drawn from peer-reviewed and institutional sources. Tool entries are kept in this site's
      GitHub repository, where anyone can propose a correction. Case study figures are checked against published
      city reports and academic literature before they are included.
    </p>
    {sources.map(([src, desc]) => (
      <div class="row two">
        <span class="row-title">{src}</span>
        <span class="row-sub">{desc}</span>
      </div>
    ))}

    <div class="group-head">
      <h2>Download the catalogue</h2>
    </div>
    <p class="para">
      Every tool and case study as open data, generated from the site content so it never drifts. Free to reuse with attribution.
    </p>
    <div class="downloads">
      <a href="/catalog.csv" download class="btn-primary">Download CSV</a>
      <a href="/catalog.json" class="btn-secondary">Open JSON</a>
    </div>

  </div>
</BaseLayout>

<style>
  .page { padding-bottom: 6rem; }
  .counts { display: flex; flex-wrap: wrap; }
  .counts > div { flex: 1 1 11rem; padding: 1rem 1.5rem 0 0; }
  .counts dd { font-family: var(--font-mono); font-size: 2.5rem; line-height: 1.1; }
  .counts dt { margin-top: 0.375rem; color: var(--ink-2); }
  .para { max-width: 44rem; margin: 0.5rem 0 1rem; font-size: 1.0625rem; color: var(--ink-2); }
  .row.two { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 768px) {
    .row.two { grid-template-columns: 18rem minmax(0, 1fr); }
  }
  .downloads { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
</style>
