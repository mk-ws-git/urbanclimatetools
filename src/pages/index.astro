---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CityIndex from '../components/CityIndex.astro';
import ToolFinder from '../components/ToolFinder.astro';
import { getCatalogStats } from '../lib/catalog';
import { categoryLabel } from '../lib/labels.mjs';

const allTools = await getCollection('tools');
const allStudies = await getCollection('case-studies');
const stats = await getCatalogStats();

// Versioned so social platforms (LinkedIn caches by URL) refetch the card when the counts change.
const ogVersion = `${allTools.length}-${allStudies.length}-${stats.countryCount}`;

// "Free to use" tools are free but proprietary; everything else carries an open licence.
const openLicensed = allTools.filter((t) => t.data.license !== 'Free-to-use').length;

const categoryOrder = ['heat', 'flood', 'coastal', 'green', 'data', 'planning'];
const categories = categoryOrder.map((cat, i) => ({
  cat,
  num: String(i + 1).padStart(2, '0'),
  label: categoryLabel(cat),
  count: stats.categoryCounts[cat] ?? 0,
}));

const featuredStudies = allStudies
  .filter((s) => s.data.featured && s.data.statValue && s.data.statLabel)
  .slice(0, 3);
---

<BaseLayout title="Urban Climate Tools" ogImage={`/og/home-${ogVersion}.jpg`} description={`A field guide to adapting cities: ${allTools.length} free tools and ${allStudies.length} city case studies for urban climate practitioners.`}>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-title">
        <p class="section-label">A field guide to adapting cities</p>
        <h1>Every part of a city can do climate work.</h1>
      </div>
      <p class="hero-lede">
        {allTools.length} free tools and {allStudies.length} city case studies, indexed by the part of the city they act on.
        Pick a number on the drawing to start.
      </p>
    </section>

    <CityIndex />

    <!-- Catalogue in numbers -->
    <section class="numbers" aria-label="Catalogue in numbers">
      <div>
        <p class="num">{allTools.length}</p>
        <p class="num-label">free tools, {openLicensed} with open licences</p>
      </div>
      <div>
        <p class="num">{allStudies.length}</p>
        <p class="num-label">city case studies</p>
      </div>
      <div>
        <p class="num">{stats.countryCount}</p>
        <p class="num-label">countries</p>
      </div>
      <div>
        <p class="num">{stats.continentCount}</p>
        <p class="num-label">continents</p>
      </div>
    </section>

    <!-- Index by problem -->
    <section class="split">
      <div class="split-head">
        <p class="section-label">Index</p>
        <h2>Or start from the problem.</h2>
      </div>
      <nav class="index-list" aria-label="Tools by challenge">
        {categories.map((c) => (
          <a href={`/tools?cat=${c.cat}`} class="index-row">
            <span class="index-num">{c.num}</span>
            <span class="index-name">{c.label}</span>
            <span class="index-count">{c.count} tools</span>
          </a>
        ))}
      </nav>
    </section>

    <!-- Tool finder -->
    <section class="split">
      <div class="split-head">
        <p class="section-label">Two questions</p>
        <h2>Not sure where to start?</h2>
        <p class="split-lede">
          Answer two quick questions and get the tools that fit your challenge and your technical background.
        </p>
      </div>
      <div class="split-body">
        <ToolFinder />
      </div>
    </section>

    <!-- Case studies -->
    <section class="cases">
      <div class="cases-head">
        <h2>What cities have actually done.</h2>
        <a href="/case-studies" class="text-link">All {allStudies.length} case studies</a>
      </div>
      <div class="case-grid">
        {featuredStudies.map((s) => (
          <a href={`/case-studies/${s.id}`} class="case">
            <p class="case-place">{s.data.city}, {s.data.country}</p>
            <p class="case-stat">{s.data.statValue}</p>
            <p class="case-label">{s.data.statLabel}</p>
            <p class="case-title">{s.data.title}</p>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.5rem 4rem;
    padding: 4.5rem 0 2.5rem;
  }
  .hero-title { flex: 999 1 520px; min-width: 0; }
  .hero h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 5.4vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .hero-lede {
    flex: 1 1 320px;
    max-width: 26rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .numbers {
    display: flex;
    flex-wrap: wrap;
    margin-top: 4.5rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .numbers > div { flex: 1 1 200px; padding: 1.75rem 1.5rem 1.75rem 0; }
  .num { font-family: var(--font-mono); font-size: 2.5rem; line-height: 1.1; }
  .num-label { margin-top: 0.375rem; color: var(--ink-2); }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    padding: 6rem 0 0;
  }
  .split-head { flex: 1 1 320px; min-width: 0; }
  .split-head h2,
  .cases-head h2 {
    font-size: clamp(1.875rem, 3.2vw, 2.75rem);
    line-height: 1.05;
  }
  .split-head h2 { margin-top: 1rem; }
  .split-lede { margin-top: 1rem; max-width: 26rem; color: var(--ink-2); }
  .split-body { flex: 999 1 480px; min-width: 0; }

  .index-list {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .index-row {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    transition: border-color 0.15s;
  }
  .index-row:hover { border-bottom-color: var(--accent); }
  .index-num { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-3); }
  .index-name { flex: 1; font-size: 1.375rem; font-weight: 500; letter-spacing: -0.015em; }
  .index-count { font-family: var(--font-mono); font-size: 0.875rem; color: var(--ink-2); }

  .cases { padding: 6rem 0; }
  .cases-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }
  .text-link {
    padding: 0.75rem 0;
    font-size: 0.9375rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case-grid { display: flex; flex-wrap: wrap; gap: 2rem; }
  .case {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink-3);
    transition: border-color 0.15s;
  }
  .case:hover { border-top-color: var(--accent); }
  .case-place {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .case-stat {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    font-size: 3rem;
    line-height: 1;
    color: var(--green);
  }
  .case-label { color: var(--ink-2); }
  .case-title {
    margin-top: 0.75rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }
</style>
